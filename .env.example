# --- Database (libsql) ---
# Local dev: leave both unset and the app uses a SQLite file at data/impacta.db.
# Production / Vercel: point at a Turso (or any libsql) database.
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- Optional: Claude assistant for the briefing wizard ---
# If unset, the wizard still works using a deterministic heuristic.
ANTHROPIC_API_KEY=

# --- Optional: storage paths (only used in file-mode) ---
# IMPACTA_DB_PATH=
# IMPACTA_UPLOADS_DIR=
